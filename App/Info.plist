<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>TMEjectGuard</string>
    <key>CFBundleIdentifier</key>
    <string>sk.moravcik.tmejectguard</string>
    <key>CFBundleName</key>
    <string>TM Eject Guard</string>
    <key>CFBundleDisplayName</key>
    <string>TM Eject Guard</string>
    <!-- No Dock icon, but Finder, notifications and Sparkle's windows still
         show this. CFBundleIconName is the Assets.car icon macOS 26 draws;
         CFBundleIconFile the .icns older systems fall back to. Both come from
         AppIcon.icon via make-icon.sh. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu bar only: no Dock icon, no Cmd-Tab entry. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSCalendarsUsageDescription</key>
    <string>Reads your upcoming meetings so the external disk can be ejected before you unplug it.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Reads your upcoming meetings so the external disk can be ejected before you unplug it.</string>
    <!-- Sparkle. The feed is a stable path in the repository rather than a
         release asset, so the URL never changes and a release only has to
         rewrite one file. SUPublicEDKey is the public half of the EdDSA key
         that signs update archives; the private half lives in the login
         keychain and is what an attacker would need to serve a malicious
         update. -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/m-moravcik/tm-eject-guard/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>ciayVzrfVUd/AHaU8EB8T7xsMfathzO3rKMGxHK1xEk=</string>
    <!-- Sparkle's own default is to ask on first launch. A menu bar utility has
         no launch the user is watching, so the answer is made here instead. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- Daily. Sparkle's default is weekly, which for a tool that guards a disk
         every working day is longer than it needs to be. -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- The four interface languages. Without this macOS reports only the
         development region and Sparkle's own windows ignore the rest. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>sk</string>
        <string>cs</string>
        <string>de</string>
    </array>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
